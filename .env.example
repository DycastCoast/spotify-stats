# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so your secrets never end up on GitHub.

# From developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=paste-client-id-here
SPOTIFY_CLIENT_SECRET=paste-client-secret-here

# Must match the Redirect URI in the dashboard EXACTLY (no trailing slash)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=paste-random-string-here

# ---- Only for the LIVE site (PythonAnywhere). Leave these out on your own PC. ----
# PRODUCTION=1 makes the login cookie HTTPS-only.
# PRODUCTION=1
# SPOTIFY_REDIRECT_URI=https://yourname.pythonanywhere.com/callback
# The key the "alarm clock" must send to /internal/poll. Generate one the same way as above.
# POLL_KEY=paste-another-random-string-here

# ---- Only on the PC or Pi that runs ping_site.py ----
# LIVE_SITE=https://yourname.pythonanywhere.com
# POLL_KEY=the-same-key-as-the-live-site
